{
  "manifest_version": 3,
  "name": "Yt Player Automation",
  "version": "1.0",
  "description": "YouTube automation of interaction with the media player",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*", "*://*.youtube.com/aboutthisad*"], 
	  "js": ["player-controller.js"],
	  "all_frames": true,
	  "run_at": "document_end"
    }
  ]
}